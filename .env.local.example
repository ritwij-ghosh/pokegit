# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real tokens.

# GitHub personal access token (classic or fine-grained).
# Only needs public read access: public_repo / "Public repositories" read-only.
# Used server-side only for both the GraphQL and REST GitHub calls.
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API key, used server-side only to generate the Pokedex flavor text.
# If this is unset the app still works; it falls back to a deterministic
# locally-generated flavor entry instead of failing the page.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional. Defaults to a current Claude model if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5
