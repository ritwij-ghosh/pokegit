# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real tokens.

# GitHub personal access token (classic or fine-grained).
# Only needs public read access: public_repo / "Public repositories" read-only.
# Used server-side only for both the GraphQL and REST GitHub calls.
GITHUB_TOKEN=ghp_your_token_here

# Groq API key — generates Pokédex flavor text once per username.
# Free tier: https://console.groq.com
# If unset, a deterministic offline entry is cached instead (no live LLM calls).
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to llama-3.1-8b-instant (fast/cheap blurbs).
# Alternatives: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Supabase — permanent generate-once cache for Pokédex entries.
# Prefer the service role key server-side. Anon key works with the fill-once RLS
# policies, but service role is safer for production writes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend — sends feature-request emails from /contact.
# Free tier: https://resend.com
# Until you verify a domain, use onboarding@resend.dev as the from address
# (Resend only delivers to the account owner's email in that mode).
RESEND_API_KEY=re_your_key_here
# Optional. Defaults to PokeGit <onboarding@resend.dev>
RESEND_FROM=PokeGit <onboarding@resend.dev>

